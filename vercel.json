{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "milanalbertz.com" }
      ],
      "destination": "https://milanalbertz.nl/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.milanalbertz.com" }
      ],
      "destination": "https://milanalbertz.nl/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/trips",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|LinkedInBot|Discordbot|TelegramBot|Pinterest|Mastodon|Bluesky|Googlebot|bingbot|Applebot|Embedly|SkypeUriPreview|Iframely|redditbot|Snapchat|vkShare).*"
        }
      ],
      "destination": "/api/trips-preview"
    },
    { "source": "/((?!api/|@|.*\\..*).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "public/frames/*-static.svg"
    }
  },
  "images": {
    "remotePatterns": [
      { "protocol": "https", "hostname": "*.public.blob.vercel-storage.com" }
    ],
    "sizes": [640, 2048, 3072, 3840],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 2592000
  }
}
