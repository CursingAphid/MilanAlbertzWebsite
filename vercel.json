{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "milanalbertz.com" }
      ],
      "destination": "https://milanalbertz.nl/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.milanalbertz.com" }
      ],
      "destination": "https://milanalbertz.nl/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!api/|@|.*\\..*).*)", "destination": "/index.html" }
  ],
  "images": {
    "remotePatterns": [
      { "protocol": "https", "hostname": "*.public.blob.vercel-storage.com" }
    ],
    "sizes": [640, 2048],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 2592000
  }
}
